; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Epic Tycoon"
config/version="0.0.1"
run/main_scene="uid://b6hqrvvuhqeve"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

LitManager="*uid://brf2hvdtyyw3q"
VoxlyDebug="*uid://bhjy0yw7y2ltx"
VoxlyConfig="*uid://bo3p7ft7wku4g"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/SpacetimeDB/plugin.cfg", "res://addons/ez_tiles/plugin.cfg", "res://addons/lit/plugin.cfg", "res://addons/project-time-tracker/plugin.cfg", "res://addons/voxly-core/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[shader_globals]

lit_light_data={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_light_count={
"type": "int",
"value": 0
}
lit_viewport_size={
"type": "vec2",
"value": Vector2(0, 0)
}
lit_canvas_scale={
"type": "float",
"value": 1.0
}
lit_world_sdf={
"filter": "linear",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_wsdf_basis={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_wsdf_origin={
"type": "vec2",
"value": Vector2(0, 0)
}
lit_ambient_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
lit_ambient_energy={
"type": "float",
"value": 1.0
}
lit_shadow_steps_max={
"type": "int",
"value": 64
}
lit_shadow_step_scaling={
"type": "bool",
"value": false
}
lit_tile_size={
"type": "int",
"value": 64
}
lit_tile_grid={
"type": "ivec2",
"value": Vector2i(0, 0)
}
lit_directional_count={
"type": "int",
"value": 0
}
lit_lighting_model={
"type": "int",
"value": 0
}
lit_tile_headers={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_tile_indices={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_cookie_atlas={
"filter": "linear",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_ysort_enabled={
"type": "bool",
"value": false
}
lit_ysort_band={
"type": "float",
"value": 12.0
}
lit_occ_data={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_occ_headers={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_occ_indices={
"filter": "nearest",
"repeat": "disable",
"type": "sampler2D",
"value": ""
}
lit_gx_count={
"type": "int",
"value": 0
}
lit_gx_rect0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_gx_rect1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_gx_rect2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_gx_rect3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_ramp_count={
"type": "int",
"value": 0
}
lit_ramp_rect0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lit_ramp_rect1={
